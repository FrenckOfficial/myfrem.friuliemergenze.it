rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function userRole() {
      return isLoggedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isStaff() {
      return isLoggedIn() &&
        userRole() in ["simplestaff", "modstaff", "advstaff", "advstaffplus", "superadmin"];
    }
    
    function isModStaff() {
      return isLoggedIn() &&
        userRole() in ["modstaff", "advstaff", "advstaffplus", "superadmin"];
    }

    function isAdminPlus() {
      return isLoggedIn() &&
        userRole() in ["advstaffplus", "superadmin"];
    }

    function privilegedFieldsUnchanged() {
      return request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('accountType', null) == resource.data.get('accountType', null)
        && request.resource.data.get('associationId', null) == resource.data.get('associationId', null)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['emailVerified', 'status', 'deletedAt', 'verifyEmailSentAt', 'verifyLink', 'staffNewUserNotifiedAt']);
    }

    function verificationFieldsValidOnCreate() {
      let d = request.resource.data;
      return !('verifyEmailSentAt' in d)
        && !('verifyLink' in d)
        && !('staffNewUserNotifiedAt' in d)
        && ((d.get('emailVerified', false) == false && d.get('status', 'inattivo') == 'inattivo')
            || (isLoggedIn()
                && request.auth.token.email_verified == true
                && d.get('email', null) == request.auth.token.email));
    }

    function memberPath(assocId) {
      return /databases/$(database)/documents/associations/$(assocId)/members/$(request.auth.uid);
    }

    function isConfirmedMember(assocId) {
      return isLoggedIn()
        && exists(memberPath(assocId))
        && get(memberPath(assocId)).data.stato == 'confermata';
    }

    function isAssocAccount(assocId) {
      return isConfirmedMember(assocId)
        && get(memberPath(assocId)).data.role == 'associazione';
    }

    function hasPerm(assocId, perm) {
      return isConfirmedMember(assocId)
        && get(memberPath(assocId)).data.role == 'referente'
        && perm in get(memberPath(assocId)).data.get('permessi', []);
    }

    function assocIsApproved(assocId) {
      return exists(/databases/$(database)/documents/associations/$(assocId))
        && get(/databases/$(database)/documents/associations/$(assocId)).data.stato == 'approvata';
    }

    function assocDocPath(assocId) {
      return /databases/$(database)/documents/associations/$(assocId);
    }

    function isValidNotificationShape() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'userId', 'title', 'message', 'icon', 'actionUrl', 'actionLabel',
          'type', 'associationId', 'read', 'archived', 'createdAt'
        ])
        && d.userId is string && d.userId.size() > 0
        && d.associationId is string && d.associationId.size() > 0
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.message is string && d.message.size() <= 300
        && d.icon is string && d.icon.size() <= 8
        && d.actionLabel is string && d.actionLabel.size() <= 40
        && d.actionUrl is string && d.actionUrl.size() <= 200
        && d.actionUrl.matches('^/[^/].*')
        && d.read == false
        && d.archived == false
        && d.createdAt == request.time;
    }

    function isJoinRequestNotification() {
      let d = request.resource.data;
      return isLoggedIn()
        && d.type == 'association_join_request'
        && isValidNotificationShape()
        && exists(/databases/$(database)/documents/associations/$(d.associationId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/associations/$(d.associationId)/members/$(request.auth.uid)).data.stato == 'richiesta'
        && exists(assocDocPath(d.associationId))
        && get(assocDocPath(d.associationId)).data.ownerUid == d.userId;
    }

    function isJoinDecisionNotification() {
      let d = request.resource.data;
      return isLoggedIn()
        && d.type == 'association_join_decision'
        && isValidNotificationShape()
        && isAssocAccount(d.associationId)
        && exists(/databases/$(database)/documents/associations/$(d.associationId)/members/$(d.userId));
    }

    match /users/{userId} {
      allow create: if isLoggedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && !('accountType' in request.resource.data)
        && !('associationId' in request.resource.data)
        && verificationFieldsValidOnCreate();
      allow read: if (isLoggedIn() && request.auth.uid == userId) || isStaff();
      allow update: if (isLoggedIn() && request.auth.uid == userId && privilegedFieldsUnchanged())
        || isAdminPlus()
      allow delete: if isStaff();
      match /badges/{badgeId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }
    
    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    function isValidVolunteer() {
      let d = request.resource.data;
      return d.keys().hasOnly(['qualifiche', 'mansioni', 'disponibilita', 'disponibileFino', 'telefono', 'note', 'pubblico', 'aggiornatoAt'])
        && d.qualifiche is list && d.qualifiche.size() <= 20
        && d.mansioni is list && d.mansioni.size() <= 10
        && d.disponibilita is map
        && d.disponibilita.keys().hasOnly(['lun', 'mar', 'mer', 'gio', 'ven', 'sab', 'dom'])
        && (d.disponibileFino == null
            || (d.disponibileFino is timestamp && d.disponibileFino <= request.time + duration.value(13, 'h')))
        && d.telefono is string && d.telefono.size() <= 30
        && d.note is string && d.note.size() <= 500
        && d.pubblico is map
        && d.pubblico.keys().hasOnly(['qualifiche', 'mansioni', 'associazioni'])
        && d.aggiornatoAt == request.time;
    }

    match /volunteers/{uid} {
      allow read: if (isLoggedIn() && request.auth.uid == uid) || isModStaff();
      allow create, update: if isLoggedIn() && request.auth.uid == uid && isValidVolunteer();
      allow delete: if isLoggedIn() && request.auth.uid == uid;
    }

    match /users_whatsapp/{docId} {
      allow read, write: if isStaff();
    }

    match /photos/{photoId} {
      allow read: if true;

      allow create: if isLoggedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('status', '') == 'Foto in attesa di approvazione'
        && !request.resource.data.keys().hasAny([
             'published', 'updater', 'updatedAt', 'reviewedAt', 'rejectionReason',
             'vehicleLink', 'staffNotifiedAt', 'uploadMailSentAt'
           ]);

      allow update: if isStaff();

      allow delete: if isLoggedIn() && (
        resource.data.userId == request.auth.uid ||
        isStaff()
      );

      match /votes/{voteId} {
        allow read: if isLoggedIn();

        allow create, update: if isLoggedIn()
          && request.auth.uid == voteId
          && request.resource.data.keys().hasOnly(['voteType', 'createdAt'])
          && request.resource.data.voteType in ['like', 'dislike']
          && get(/databases/$(database)/documents/photos/$(photoId)).data.userId != request.auth.uid;

        allow delete: if isLoggedIn() && request.auth.uid == voteId;
      }
    }

    match /twoFactorChallenges/{uid} {
      allow read, write: if false;
    }

    match /messages/{docId} {
      allow read, write: if isStaff();
    }

    match /candidatureStaff/{docId} {
      allow read, delete: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['nome', 'eta', 'email', 'motivazione', 'timestamp'])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 120
        && request.resource.data.eta is string && request.resource.data.eta.size() <= 10
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.motivazione is string && request.resource.data.motivazione.size() <= 5000
        && request.resource.data.timestamp is timestamp;
      allow update: if false;
    }

    match /sondaggi_gradimento/{docId} {
      allow read, update, delete: if isStaff();
      allow create: if request.resource.data.size() <= 40;
    }

    match /expulsionReports/{docId} {
      allow read, write: if isStaff();
    }

    match /activities/{docId} {
      allow read, delete: if isStaff();
      allow create: if isLoggedIn()
        && request.resource.data.type is string
        && request.resource.data.timestamp == request.time
        && (isStaff()
            || (request.resource.data.type == 'user_creation'
                && request.resource.data.keys().hasOnly(['type', 'userName', 'timestamp'])
                && request.resource.data.userName is string
                && request.resource.data.userName.size() <= 200)
            || (request.resource.data.type == 'photo_submission'
                && request.resource.data.keys().hasOnly(['type', 'userId', 'timestamp'])
                && request.resource.data.userId == request.auth.uid)
            || (request.resource.data.type == 'association_deactivation_request'
                && request.resource.data.keys().hasOnly(['type', 'associationId', 'associationName', 'userId', 'email', 'timestamp'])
                && request.resource.data.userId == request.auth.uid
                && isAssocAccount(request.resource.data.associationId)));
      allow update: if false;
    }

    match /emailVerifications/{docId} {
      allow read, write: if false;
    }
    
    match /logins/{docId} {
      allow read, delete: if isStaff();
      allow create: if isLoggedIn()
        && request.resource.data.keys().hasOnly(['userId', 'email', 'userAgent', 'ipAddress', 'timestamp'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500
        && request.resource.data.ipAddress is string && request.resource.data.ipAddress.size() <= 60
        && request.resource.data.timestamp == request.time;
      allow update: if false;
    }
    
    match /email_logs/{docId} {
      allow read, write: if isStaff();
    }
    
    match /reunionsReports/{docId} {
      allow get: if true;
      allow list, write: if isStaff();
    }
    
    match /staffDocUploads/{docId} {
      allow read, write: if isStaff();
    }
    
    match /groupPermissions/{docId} {
      allow read, write: if isStaff();
    }
    
    match /newsletterSubs/{docId} {
      allow read, update, delete: if isStaff();
      allow create: if false;
    }
    
    match /newsletterDrafts/{docId} {
      allow read, write: if isStaff();
    }
    
    match /newsletterSent/{docId} {
      allow read, write: if isStaff();
    }
    
    match /pdfTemplates/{docId} {
      allow read, write: if isStaff();
    }
    
    match /generatedDocuments/{docId} {
      allow read, write: if isStaff();
    }
    
    match /staffers/{docId} {
      allow read, write: if isStaff();
    }
    
    match /vehiclesDraft/{docId} {
      allow read, write: if isStaff();
    }
    
    match /newsDrafts/{docId} {
      allow read, write: if isStaff();
    }
    
    match /photobooksDraft/{docId} {
      allow read, write: if isStaff();
    }
    
    match /surveys/{docId} {
      allow read, write: if isStaff();
    }
    
    match /badges/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /notifications/{docId} {
      allow read: if isLoggedIn()
        && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isStaff()
        || isJoinRequestNotification()
        || isJoinDecisionNotification();
      allow write: if request.auth.uid != null 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['modstaff', 'advstaff', 'advstaffplus', 'superadmin'];    
      allow update: if request.auth.uid == resource.data.userId;     
      allow delete: if request.auth.uid == resource.data.userId;
    }
    
    match /viewedPages/{docId} {
      allow read, delete: if isStaff();
      allow create: if isLoggedIn()
        && request.resource.data.keys().hasOnly(['type', 'page', 'userId', 'associationId', 'timestamp'])
        && request.resource.data.get('associationId', '') is string
        && request.resource.data.get('associationId', '').size() <= 40
        && request.resource.data.type == 'page_view'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 200
        && request.resource.data.timestamp == request.time;
      allow update: if false;
    }
    
    match /numeriUtili/{docId} {
      allow get, list: if resource.data.approvato == true || isStaff();
      allow create: if request.resource.data.keys().hasOnly(['nome', 'categoria', 'telefono', 'email', 'descrizione', 'approvato', 'createdAt'])
        && request.resource.data.approvato == false
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 150
        && request.resource.data.categoria is string && request.resource.data.categoria.size() <= 80
        && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 40
        && (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
        && (request.resource.data.descrizione == null || (request.resource.data.descrizione is string && request.resource.data.descrizione.size() <= 2000))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isStaff();
    }

    match /modificheProposte/{docId} {
      allow read, delete: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['numeroId', 'nomeRealta', 'campo', 'valoreAttuale', 'valoreProposto', 'createdAt'])
        && request.resource.data.numeroId is string && request.resource.data.numeroId.size() <= 40
        && exists(/databases/$(database)/documents/numeriUtili/$(request.resource.data.numeroId))
        && request.resource.data.campo in ['nome', 'categoria', 'telefono', 'email', 'descrizione']
        && request.resource.data.nomeRealta is string && request.resource.data.nomeRealta.size() <= 150
        && (request.resource.data.valoreAttuale == null || (request.resource.data.valoreAttuale is string && request.resource.data.valoreAttuale.size() <= 2000))
        && request.resource.data.valoreProposto is string && request.resource.data.valoreProposto.size() > 0 && request.resource.data.valoreProposto.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    match /feedback/{docId} {
      allow read, update, delete: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['rating', 'category', 'message', 'timestamp', 'userAgent', 'referrer', 'createdAt', 'status'])
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.category is string && request.resource.data.category.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 40
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500
        && request.resource.data.referrer is string && request.resource.data.referrer.size() <= 500
        && request.resource.data.status == 'nuovo'
        && request.resource.data.createdAt == request.time;
    }

    match /testimonials/{docId} {
      allow read, write: if isStaff();
    }
    
    function feedPostPath(postId) {
      return /databases/$(database)/documents/feedPosts/$(postId);
    }

    function canReadFeedPost(post) {
      return isLoggedIn()
        && (isModStaff()
            || post.authorUid == request.auth.uid
            || (post.hidden == false
                && (post.visibility == 'community' || isConfirmedMember(post.associationId))));
    }

    function canWriteFeed() {
      return isLoggedIn() && userRole() != 'testacc';
    }

    function isValidFeedPost() {
      let d = request.resource.data;
      return d.keys().hasOnly(['authorUid', 'authorName', 'authorPhoto', 'authorRole', 'associationId', 'associationName', 'visibility', 'official', 'text', 'media', 'hidden', 'createdAt'])
        && d.authorUid == request.auth.uid
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 120
        && d.authorPhoto is string && d.authorPhoto.size() <= 500
        && (d.authorPhoto == '' || d.authorPhoto.matches('^https://.*'))
        && d.text is string && d.text.size() <= 2000
        && d.media is list && d.media.size() <= 6
        && (d.text.size() > 0 || d.media.size() > 0)
        && d.hidden == false
        && d.official is bool
        && d.visibility in ['community', 'association']
        && d.associationId is string
        && d.associationName is string && d.associationName.size() <= 120
        && d.createdAt == request.time
        && (d.associationId == ''
            ? (d.visibility == 'community' && d.official == false && d.authorRole == 'user')
            : (isConfirmedMember(d.associationId)
               && assocIsApproved(d.associationId)
               && d.authorRole == get(memberPath(d.associationId)).data.role
               && (d.official == false || d.authorRole in ['associazione', 'referente'])));
    }

    match /feedPosts/{postId} {
      allow get, list: if canReadFeedPost(resource.data);

      allow create: if canWriteFeed() && isValidFeedPost();

      allow update: if isModStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['hidden', 'reportCount', 'moderatedBy', 'moderatedAt'])
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt == request.time;

      allow delete: if isLoggedIn()
        && (resource.data.authorUid == request.auth.uid
            || isModStaff()
            || (resource.data.associationId != '' && isAssocAccount(resource.data.associationId)));

      match /likes/{uid} {
        allow get: if isLoggedIn() && request.auth.uid == uid;
        allow create: if canWriteFeed()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && canReadFeedPost(get(feedPostPath(postId)).data);
        allow delete: if isLoggedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if canReadFeedPost(get(feedPostPath(postId)).data);
        allow create: if canWriteFeed()
          && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'authorPhoto', 'text', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 120
          && request.resource.data.authorPhoto is string
          && request.resource.data.authorPhoto.size() <= 500
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && canReadFeedPost(get(feedPostPath(postId)).data);
        allow delete: if isLoggedIn()
          && (resource.data.authorUid == request.auth.uid
              || isModStaff()
              || get(feedPostPath(postId)).data.authorUid == request.auth.uid);
      }

      match /reports/{uid} {
        allow read, delete: if isModStaff();
        allow create: if canWriteFeed()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['motivo', 'createdAt'])
          && request.resource.data.motivo in ['spam', 'offensivo', 'privacy', 'falso', 'altro']
          && request.resource.data.createdAt == request.time
          && canReadFeedPost(get(feedPostPath(postId)).data);
      }
    }

    match /volunteerShifts/{uid}/turni/{itemId} {
      allow read: if (isLoggedIn() && request.auth.uid == uid) || isModStaff();
      allow write: if false;
    }

    match /associationRequests/{reqId} {

      function isValidAssocRequest() {
        let d = request.resource.data;
        return d.keys().hasOnly([
          'name','type','otherType','municipality','LAMail','LAPhone','site',
          'referenceRole','note','requesterUid','requesterNome','requesterEmail',
          'requesterGuest','origin','status','verifyStatus','confirmedMail','createdAt'
        ])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.type is string && d.type.size() <= 40
        && d.otherType is string && d.otherType.size() <= 80
        && d.municipality is string && d.municipality.size() <= 80
        && d.LAMail is string && d.LAMail.size() > 0 && d.LAMail.size() <= 120
        && d.LAPhone is string && d.LAPhone.size() <= 30
        && d.site is string && d.site.size() <= 200
        && d.referenceRole is string && d.referenceRole.size() > 0 && d.referenceRole.size() <= 80
        && d.note is string && d.note.size() <= 500
        && d.requesterNome is string && d.requesterNome.size() <= 120
        && d.requesterEmail is string && d.requesterEmail.size() <= 120
        && d.origin == 'richiesta'
        && d.status == 'in_attesa'
        && d.verifyStatus == 'da_verificare'
        && d.confirmedMail == false
        && d.createdAt == request.time
        && (
          (isLoggedIn()
            && d.requesterUid == request.auth.uid
            && d.requesterGuest == false)
          ||
          (!isLoggedIn()
            && d.requesterUid == null
            && d.requesterGuest == true)
        );
      }

      allow create: if isValidAssocRequest();

      allow read: if isModStaff()
        || (isLoggedIn() && resource.data.requesterUid == request.auth.uid);

      allow update, delete: if isModStaff();

      match /private/{docId} {
        allow read, write: if isModStaff();
      }
    }

    match /associations/{assocId} {
      allow get: if resource.data.stato == 'approvata'
        || isModStaff()
        || isConfirmedMember(assocId);

      allow list: if resource.data.stato == 'approvata'
        || isModStaff();

      allow create, delete: if isModStaff();

      allow update: if isModStaff()
        || (resource.data.stato == 'approvata'
            && isAssocAccount(assocId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nome', 'tipo', 'zona', 'descrizione', 'logoUrl', 'copertinaUrl', 'contatti', 'aggiornatoAt']))
        || (resource.data.stato == 'approvata'
            && hasPerm(assocId, 'pagina')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['descrizione', 'logoUrl', 'copertinaUrl', 'contatti', 'aggiornatoAt']));

      match /posts/{postId} {

        function canPublish() {
          return isAssocAccount(assocId)
            || (isConfirmedMember(assocId)
                && get(memberPath(assocId)).data.role == 'referente');
        }

        allow read: if isModStaff() || isConfirmedMember(assocId);

        allow create: if canPublish()
          && assocIsApproved(assocId)
          && request.resource.data.keys().hasOnly([
               'authorUid', 'authorName', 'authorRole', 'text', 'imageUrl', 'createdAt'
             ])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRole == get(memberPath(assocId)).data.role
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() <= 500
          && (request.resource.data.imageUrl == ''
              || request.resource.data.imageUrl.matches('^https://.*'))
          && request.resource.data.createdAt == request.time;

        allow update: if false;

        allow delete: if isModStaff()
          || isAssocAccount(assocId)
          || (isConfirmedMember(assocId) && resource.data.authorUid == request.auth.uid);
      }

      match /members/{uid} {
        allow read: if isModStaff()
          || (isLoggedIn() && request.auth.uid == uid)
          || isAssocAccount(assocId)
          || hasPerm(assocId, 'membri');

        allow create: if isModStaff()
          || (isLoggedIn()
              && request.auth.uid == uid
              && assocIsApproved(assocId)
              && request.resource.data.role == 'membro'
              && request.resource.data.stato == 'richiesta'
              && !('volontario' in request.resource.data));

        allow update: if isModStaff()
          || (isAssocAccount(assocId)
              && resource.data.role != 'associazione'
              && request.resource.data.role in ['membro', 'referente']
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['volontario']))
          || (hasPerm(assocId, 'membri')
              && resource.data.role == 'membro'
              && request.resource.data.role == 'membro'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['stato', 'aggiornatoAt']));

        allow delete: if isModStaff()
          || (isAssocAccount(assocId) && resource.data.role != 'associazione')
          || (isLoggedIn() && request.auth.uid == uid
              && resource.data.role != 'associazione');
      }

      match /shifts/{shiftId} {

        function isShiftManager() {
          return isAssocAccount(assocId) || hasPerm(assocId, 'turni') || hasPerm(assocId, 'membri');
        }

        function isValidShift() {
          let d = request.resource.data;
          return d.titolo is string && d.titolo.size() > 0 && d.titolo.size() <= 80
            && d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.inizio is string && d.inizio.matches('^[0-2][0-9]:[0-5][0-9]$')
            && d.fine is string && d.fine.matches('^[0-2][0-9]:[0-5][0-9]$')
            && d.luogo is string && d.luogo.size() <= 120
            && d.posti is int && d.posti >= 1 && d.posti <= 50
            && d.note is string && d.note.size() <= 500
            && d.mansione is string && d.mansione.size() <= 40
            && d.qualifica is string && d.qualifica.size() <= 40
            && d.stato in ['aperto', 'annullato'];
        }

        allow read: if isModStaff() || isConfirmedMember(assocId);

        allow create: if isShiftManager()
          && assocIsApproved(assocId)
          && request.resource.data.keys().hasOnly(['titolo', 'data', 'inizio', 'fine', 'luogo', 'posti', 'note', 'mansione', 'qualifica', 'stato', 'creatoDa', 'createdAt', 'aggiornatoAt'])
          && isValidShift()
          && request.resource.data.stato == 'aperto'
          && request.resource.data.creatoDa == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.aggiornatoAt == request.time;

        allow update: if isShiftManager()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['titolo', 'data', 'inizio', 'fine', 'luogo', 'posti', 'note', 'mansione', 'qualifica', 'stato', 'aggiornatoAt'])
          && isValidShift()
          && request.resource.data.aggiornatoAt == request.time;

        allow delete: if isModStaff() || isAssocAccount(assocId);

        match /signups/{uid} {
          allow read: if isModStaff()
            || (isLoggedIn() && request.auth.uid == uid)
            || isShiftManager();

          allow create: if isLoggedIn()
            && request.auth.uid == uid
            && userRole() != 'testacc'
            && isConfirmedMember(assocId)
            && get(memberPath(assocId)).data.role in ['membro', 'referente']
            && get(/databases/$(database)/documents/associations/$(assocId)/shifts/$(shiftId)).data.stato == 'aperto'
            && request.resource.data.keys().hasOnly(['stato', 'presente', 'createdAt', 'aggiornatoAt'])
            && request.resource.data.stato == 'candidato'
            && request.resource.data.presente == true
            && request.resource.data.createdAt == request.time
            && request.resource.data.aggiornatoAt == request.time;

          allow update: if isShiftManager()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'presente', 'aggiornatoAt'])
            && request.resource.data.stato in ['candidato', 'confermato', 'rifiutato']
            && request.resource.data.presente is bool
            && request.resource.data.aggiornatoAt == request.time;

          allow delete: if isModStaff()
            || isShiftManager()
            || (isLoggedIn() && request.auth.uid == uid);
        }
      }
    }
  }
}